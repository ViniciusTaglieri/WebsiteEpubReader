---
const screenshots = [
  {
    src: "/images/library.png",
    title: "Biblioteca visual",
    text: "Grade de livros, importacao local, busca, filtros e progresso de leitura.",
  },
  {
    src: "/images/reader.png",
    title: "Leitor focado",
    text: "Pagina centralizada, progresso global e navegacao lateral discreta.",
  },
  {
    src: "/images/settings.png",
    title: "Configuracoes completas",
    text: "Tema do app, preferencias do texto e layout do leitor no mesmo fluxo.",
  },
];
---

<section id="capturas" class="mx-auto w-[min(100%-32px,1180px)] py-16">
  <div class="mb-9 max-w-[700px]">
    <h2 class="font-display text-[clamp(2rem,4vw,3rem)] font-black tracking-[-0.03em]">
      Uma experiencia desktop feita para leitores
    </h2>
    <p class="mt-3 text-[17px] leading-7 text-muted">
      As capturas reais do app sustentam o site: biblioteca, configuracoes e leitura aparecem como
      produto principal, nao como promessa abstrata.
    </p>
  </div>
  <div class="grid gap-6 lg:grid-cols-3">
    {
      screenshots.map((shot) => (
        <article
          key={shot.title}
          class="overflow-hidden rounded-[10px] border border-line bg-surface shadow-[0_16px_38px_rgb(60_38_9_/_8%)]"
        >
          <img
            src={shot.src}
            alt={shot.title}
            class="aspect-[16/10] w-full object-cover object-left-top"
            loading="lazy"
          />
          <div class="p-5">
            <h3 class="text-lg font-medium">{shot.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{shot.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
