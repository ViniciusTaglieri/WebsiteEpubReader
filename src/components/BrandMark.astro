---
const { small = false } = Astro.props;
---

<span
  class:list={[
    "relative inline-block shrink-0 rounded-[5px_5px_2px_2px] border-[3px] border-gold-strong text-gold-strong",
    small ? "h-[17px] w-[14px] border-[1.5px]" : "h-[31px] w-[25px]",
  ]}
  aria-hidden="true"
>
  <span
    class:list={[
      "absolute rounded-sm bg-current",
      small ? "left-[4px] top-[3px] h-[8px] w-[1.5px]" : "left-[7px] top-[5px] h-[14px] w-[3px]",
    ]}></span>
  <span
    class:list={[
      "absolute rounded-sm bg-current",
      small ? "left-[8px] top-[3px] h-[8px] w-[1.5px]" : "left-[14px] top-[5px] h-[14px] w-[3px]",
    ]}></span>
  <span
    class:list={[
      "absolute rounded-sm bg-current",
      small
        ? "bottom-[3px] left-[4px] h-[1.5px] w-[6px]"
        : "bottom-[5px] left-[7px] h-[3px] w-[9px]",
    ]}></span>
</span>
