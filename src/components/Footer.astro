---
import { Download } from "lucide-react";
import GitHubMark from "./GitHubMark.astro";

const githubUrl = "https://github.com/ViniciusTaglieri/EpubReader";
---

<footer
  class="bg-[linear-gradient(120deg,oklch(17%_0.015_68),oklch(21%_0.014_74))] py-12 text-white"
>
  <div class="mx-auto grid w-[min(100%-32px,1180px)] items-center gap-8 md:grid-cols-[1fr_auto]">
    <div>
      <h2 class="font-display text-[clamp(1.7rem,3vw,2.2rem)] font-black tracking-[-0.02em]">
        Pronto para transformar sua leitura?
      </h2>
      <p class="text-white/82 mt-3 max-w-[540px] leading-7">
        Acesse o projeto no GitHub. O botao de download esta apontando para o repositorio por
        enquanto e pode migrar para o release assim que o instalador for publicado.
      </p>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row">
      <a
        href={githubUrl}
        class="inline-flex min-h-[54px] items-center justify-center gap-3 rounded-lg bg-gradient-to-b from-gold to-gold-strong px-6 font-semibold text-white shadow-[0_12px_25px_rgb(0_0_0_/_18%)]"
      >
        <Download size={21} />
        Download para Windows
      </a>
      <a
        href={githubUrl}
        class="inline-flex min-h-[54px] items-center justify-center gap-3 rounded-lg border border-white/55 px-6 font-semibold"
      >
        <GitHubMark size={21} />
        Ver no GitHub
      </a>
    </div>
  </div>
  <div
    class="text-white/76 mx-auto mt-12 flex w-[min(100%-32px,1180px)] flex-col justify-between gap-5 text-sm leading-7 md:flex-row md:items-end"
  >
    <div>
      Leitor EPUB © {new Date().getFullYear()}<br />Feito para leitores que querem controle local.
    </div>
    <div>
      Projeto open source disponivel no
      <a class="underline underline-offset-4" href={githubUrl}>GitHub</a>.
    </div>
  </div>
</footer>
