---
import Colecoes from '../components/Colecoes.astro'
import FeatureStrip from '../components/FeatureStrip.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import { ReaderDemo } from '../components/ReaderDemo'
import '../styles.css'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const siteUrl = `https://viniciustaglieri.github.io${base}`
const heroImage = `${siteUrl}images/hero.png`

const title = 'Leitor EPUB — Sua biblioteca local para Windows'
const description =
  'Leitor EPUB desktop para Windows com biblioteca local, coleções, temas personalizáveis e leitura offline. Sem conta, sem nuvem.'

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Leitor EPUB',
  operatingSystem: 'Windows',
  applicationCategory: 'UtilitiesApplication',
  description,
  url: siteUrl,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'BRL',
  },
  downloadUrl: 'https://github.com/ViniciusTaglieri/EpubReader/releases/download/v0.1.0/Leitor.EPUB_0.1.0_x64_en-US.msi',
  codeRepository: 'https://github.com/ViniciusTaglieri/EpubReader',
})
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#a07835" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={heroImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={schema} />
  </head>
  <body class="min-h-dvh overflow-x-hidden antialiased">
    <Header />
    <main>
      <Hero />
      <ReaderDemo client:load />
      <FeatureStrip />
      <Colecoes />
    </main>
    <Footer />
  </body>
</html>
