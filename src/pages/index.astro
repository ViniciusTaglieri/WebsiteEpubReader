---
import FeatureStrip from "../components/FeatureStrip.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import { ReaderDemo } from "../components/ReaderDemo";
import Screenshots from "../components/Screenshots.astro";
import "../styles.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Leitor EPUB desktop para Windows com biblioteca local, temas, layout personalizavel e leitura offline."
    />
    <meta property="og:title" content="Leitor EPUB" />
    <meta
      property="og:description"
      content="Website visual do projeto open source EpubReader, com demo interativa das configuracoes do leitor."
    />
    <meta property="og:image" content="/images/landing-reference.png" />
    <title>Leitor EPUB - Biblioteca local e leitura personalizada</title>
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <ReaderDemo client:load />
      <FeatureStrip />
      <Screenshots />
    </main>
    <Footer />
  </body>
</html>
