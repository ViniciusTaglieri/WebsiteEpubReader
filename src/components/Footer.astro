---
import { BookMarked, Download } from 'lucide-react'
import GitHubMark from './GitHubMark.astro'

const githubUrl = 'https://github.com/ViniciusTaglieri/EpubReader'
const downloadUrl =
  'https://github.com/ViniciusTaglieri/EpubReader/releases/download/v0.2.0/Leitor.EPUB_0.1.0_x64_en-US.msi'
---

<footer
  class="bg-[linear-gradient(120deg,oklch(17%_0.015_68),oklch(21%_0.014_74))] pb-2 pt-12 text-white"
>
  <div
    class="mx-auto grid w-[min(100%-32px,1180px)] items-center gap-8 md:grid-cols-[1fr_auto]"
  >
    <div>
      <h2
        class="font-display text-[clamp(1.7rem,3vw,2.2rem)] font-black tracking-[-0.02em]"
      >
        Pronto para transformar sua leitura?
      </h2>
      <p class="text-white/82 mt-3 max-w-[540px] leading-7">
        EpubReader é um leitor EPUB desktop, local e offline, criado com foco em
        privacidade e controle do usuário. Organize sua biblioteca com coleções,
        favoritos, filtros, buscas e visualizações. Leia com conforto usando
        sumário, progresso automático, temas, ajustes de fonte e modo paginado
        ou contínuo.
      </p>
    </div>
    <div class="flex flex-col gap-4">
      <a
        href="#top"
        class="hidden items-center gap-3 text-[21px] font-semibold tracking-[-0.02em] md:inline-flex"
      >
        <BookMarked className="h-10 w-10 text-gold" />
        <span>Leitor EPUB</span>
      </a>
      <a
        href={downloadUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[54px] items-center justify-center gap-3 rounded-lg bg-gold px-6 font-semibold text-white shadow-[0_12px_25px_rgb(0_0_0_/_18%)] hover:bg-gold-strong"
      >
        <Download size={21} />
        Download
      </a>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[54px] items-center justify-center gap-3 rounded-lg border border-white/55 px-6 font-semibold hover:border-gold-strong"
      >
        <GitHubMark size={21} />
        Ver no GitHub
      </a>
    </div>
  </div>
  <div class="text-white/76 mt-12 text-center text-sm leading-7">
    Leitor EPUB © {new Date().getFullYear()}.
  </div>
</footer>
