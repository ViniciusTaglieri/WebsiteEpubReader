---
import { Bookmark, BookOpen, Heart, Tag } from 'lucide-react'

const colecoes = [
  {
    icon: BookOpen,
    label: 'Lendo agora',
    description: '3 livros em andamento',
  },
  {
    icon: Heart,
    label: 'Favoritos',
    description: '12 livros guardados',
  },
  {
    icon: Bookmark,
    label: 'Lista de leitura',
    description: '24 livros na fila',
  },
  {
    icon: Tag,
    label: 'Ficção científica',
    description: '8 livros no tema',
  },
]
---

<section id="colecoes" class="mx-auto w-[min(100%-32px,1180px)] py-16">
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_auto] lg:gap-20">
    <div class="max-w-[520px]">
      <h2
        class="font-display text-[clamp(2rem,4vw,3rem)] font-black tracking-[-0.03em]"
      >
        Organize do seu jeito
      </h2>
      <p class="mt-4 text-[17px] leading-7 text-muted">
        Crie coleções para agrupar seus livros por tema, gênero, humor ou
        qualquer critério que faça sentido para você. Sua biblioteca cresce sem
        virar bagunça.
      </p>
      <p class="mt-3 text-[15px] leading-7 text-muted">
        Favoritos, listas de leitura, séries, autores — cada agrupamento fica
        acessível na barra lateral, a um clique de distância.
      </p>
    </div>

    <div class="grid w-full grid-cols-2 gap-3 lg:w-[340px]">
      {
        colecoes.map(({ icon: Icon, label, description }) => (
          <div class="hover:border-gold/60 flex flex-col gap-3 rounded-xl border border-line bg-surface p-4 shadow-sm transition hover:shadow-[0_4px_18px_color-mix(in_oklch,var(--accent)_10%,transparent)]">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-gold-soft text-gold-strong">
              <Icon size={18} strokeWidth={1.8} />
            </span>
            <div>
              <span class="block text-sm font-semibold">{label}</span>
              <span class="mt-0.5 block text-xs text-muted">{description}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
