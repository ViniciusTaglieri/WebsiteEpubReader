---
import {
  BookOpen,
  ChartNoAxesColumnIncreasing,
  Code2,
  ShieldCheck,
  SlidersHorizontal,
} from "lucide-react";

const features = [
  {
    icon: BookOpen,
    title: "Biblioteca inteligente",
    text: "Importe, organize e encontre seus livros com facilidade.",
  },
  {
    icon: SlidersHorizontal,
    title: "Leitura personalizada",
    text: "Fontes, temas, margens e espaçamentos para seu conforto.",
  },
  {
    icon: ChartNoAxesColumnIncreasing,
    title: "Progresso local",
    text: "O app mantém sua leitura no armazenamento local do PC.",
  },
  {
    icon: ShieldCheck,
    title: "Leve e seguro",
    text: "Leitura offline, sem depender de conta ou serviço externo.",
  },
  {
    icon: Code2,
    title: "Código aberto",
    text: "Transparente, colaborativo e pronto para evoluir.",
  },
];
---

<section
  class="mx-auto grid w-[min(100%-40px,1180px)] border-y border-line py-9 md:grid-cols-2 lg:grid-cols-5"
>
  {
    features.map(({ icon: Icon, title, text }) => (
      <div class="grid min-h-[105px] grid-cols-[34px_1fr] gap-4 border-b border-line px-3 py-5 last:border-b-0 md:even:border-l md:last:col-span-2 md:last:border-l-0 lg:col-span-1 lg:border-b-0 lg:border-r lg:last:border-r-0">
        <Icon className="text-gold-strong" size={30} strokeWidth={1.7} />
        <div>
          <strong class="block text-sm">{title}</strong>
          <p class="mt-2 text-xs leading-6 text-muted">{text}</p>
        </div>
      </div>
    ))
  }
</section>
